{
    "name": "script2video",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {}
    },
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Script2Video Web UI",
            "onAutoForward": "openPreview"
        }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postStartCommand": "cd /workspaces/script2video && (nohup python3 server.py > server.log 2>&1 &) && sleep 8 && tail -5 server.log",
    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python"]
        }
    }
}
